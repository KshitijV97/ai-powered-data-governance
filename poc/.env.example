# Copy to .env (run_poc.sh does this automatically). Local POC values only.
COMPOSE_PROJECT_NAME=borealis-pipeda-poc

# OpenMetadata server JVM heap (official default is 1G; 768m fits a 4 GB Docker VM)
OPENMETADATA_HEAP_OPTS=-Xmx768m -Xms768m
ES_JAVA_OPTS=-Xms512m -Xmx512m

# Fictional bank database credentials
BANK_DB_ADMIN_PASSWORD=borealis-admin-local
OM_READER_PASSWORD=om-reader-local
ETL_PASSWORD=etl-local
ANALYST_PASSWORD=analyst-local

# OpenMetadata default admin of the quickstart image (basic auth)
OM_ADMIN_EMAIL=admin@open-metadata.org
OM_ADMIN_PASSWORD=admin

POC_SEED=5301
POC_CUSTOMERS=1500
